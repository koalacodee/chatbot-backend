# ==============================================================================
# SmartHelp Backend — Environment Configuration
# ==============================================================================
# Copy to `.env` and fill in. Generated from an exhaustive scan of every
# ConfigService.get / getOrThrow and process.env access in src/.
#
#   [REQUIRED]  the app throws on boot or on first use without it
#   [OPTIONAL]  has a code default, shown as the value here
#   [SET THIS]  technically optional, but the fallback is wrong for real use
# ==============================================================================


# ── Application ───────────────────────────────────────────────────────────────

# [OPTIONAL] Defaults to 3000 in code; the Dockerfile exposes 8080.
PORT=8080

# [REQUIRED] Global route prefix. All routes mount under it.
API_PREFIX=api/v1

# [OPTIONAL] Defaults to "development". Set to "production" to switch the
# logger from pino-pretty to JSON and harden cookie defaults.
NODE_ENV=development

# [SET THIS] Public URL of this API. Used to build profile-picture URLs
# returned to clients. Code default is http://localhost:3001 — which is the
# frontend's port, not this service's.
BASE_URL=http://localhost:8080

# [SET THIS] Public URL of the frontend dashboard. Embedded in invitation and
# notification emails. Code default is http://localhost:3001.
DASHBOARD_URL=http://localhost:3001


# ── CORS ──────────────────────────────────────────────────────────────────────

# [OPTIONAL] Comma-separated. Falls back to "*" if unset.
CORS_ORIGINS=http://localhost:3000

# [REQUIRED] Comma-separated. Read without a null guard — the app crashes at
# boot if this is missing.
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD


# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string. Used by Drizzle, Prisma, and the
# boot-time migration runner.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# [SET THIS] Path to the Drizzle migrations folder. If unset, the boot-time
# migration is SKIPPED WITH ONLY A WARNING and the app starts against whatever
# schema is already there. Set in the Dockerfile; you must set it locally.
DRIZZLE_MIGRATIONS_FOLDER=./src/common/drizzle


# ── Redis ─────────────────────────────────────────────────────────────────────
# Backs BullMQ queues, caching, guest sessions, and support-ticket OTPs.

# [REQUIRED] Read with getOrThrow and no default by the BullMQ root config.
REDIS_HOST=localhost
REDIS_PORT=6379

# [OPTIONAL] Leave empty if your Redis has no auth.
REDIS_PASSWORD=

# [OPTIONAL] Defaults to "default".
REDIS_USER=default

# [OPTIONAL] Defaults to 4. Set to 6 for IPv6-only hosts.
REDIS_IP_FAMILY=4


# ── Authentication ────────────────────────────────────────────────────────────
# Four independent secrets. Staff and guests have separate token stacks by
# design — do not reuse one value across them.
# Generate each with:  openssl rand -base64 48

# [REQUIRED] Staff access tokens (30 minute lifetime).
USER_ACCESS_TOKEN_SECRET=replace_me_staff_access_secret

# [REQUIRED] Staff refresh tokens (7 day lifetime).
USER_REFRESH_TOKEN_SECRET=replace_me_staff_refresh_secret

# [REQUIRED] Guest access tokens.
GUEST_ACCESS_TOKEN_SECRET=replace_me_guest_access_secret

# [REQUIRED] Guest refresh tokens.
GUEST_REFRESH_TOKEN_SECRET=replace_me_guest_refresh_secret

# [REQUIRED] Access tokens for attachment-group members, who authenticate
# through a separate strategy from both staff and guests.
ATTACHMENT_GROUP_MEMBER_ACCESS_TOKEN_SECRET=replace_me_attachment_group_secret


# ── Cookies ───────────────────────────────────────────────────────────────────

# [SET THIS] Signing secret for @fastify/cookie. Falls back to the literal
# string "default-secret" if unset.
COOKIE_SECRET=replace_me_cookie_secret

# [OPTIONAL] Defaults to "strict". Use "none" for cross-site frontends
# (requires the secure flags below to be true).
COOKIES_SAMESITE=strict

# NOTE: two spellings of the same setting are read in different files.
# COOKIES_SECURE (plural) is read by the token service; COOKIE_SECURE
# (singular) by the auth controller. Set BOTH to the same value until the
# duplication is resolved. Set both to true in production.
COOKIES_SECURE=false
COOKIE_SECURE=false


# ── Email (Resend) ────────────────────────────────────────────────────────────
# Invitations, password resets, OTPs, ticket replies.

# [REQUIRED] No default — email sending fails at runtime without it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# [REQUIRED] Verified sender identity.
RESEND_FROM="SmartHelp <onboarding@resend.dev>"


# ── FileHub (object storage) ──────────────────────────────────────────────────
# External upload service. Required for all attachment and profile-picture
# operations — the API mints upload tokens and signs download URLs against it.

# [REQUIRED]
FILEHUB_BASE_URL=http://localhost:4000

# [REQUIRED]
FILEHUB_API_KEY=replace_me_filehub_api_key


# ── Legacy file storage (src/files) ───────────────────────────────────────────
# The older uploader, superseded by FileHub but still mounted.

# [OPTIONAL] "local" or "ali-oss". Defaults to "local".
FILE_MANAGEMENT_SERVICE=local

# The five OSS_* values below are [REQUIRED] only when
# FILE_MANAGEMENT_SERVICE=ali-oss. Leave blank otherwise.
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# [OPTIONAL] Request timeout in ms. Defaults to 300000 (5 minutes).
OSS_TIMEOUT=300000


# ── Share links ───────────────────────────────────────────────────────────────

# [OPTIONAL] Department share-link lifetime. No default — links do not expire
# unless you set one. Value is in milliseconds.
SHARE_LINK_EXPIRY=

# [OPTIONAL] Generated key length. Defaults to 64.
SHARE_LINK_KEY_LENGTH=64


# ── Vector search (Qdrant) ────────────────────────────────────────────────────
# Stores knowledge-base embeddings for the chatbot's retrieval tool.

# [OPTIONAL] Defaults to http://localhost:6333.
QDRANT_URL=http://localhost:6333

# [OPTIONAL] Omit for a local instance without auth.
QDRANT_API_KEY=


# ── Chatbot (Moonshot / Kimi) ─────────────────────────────────────────────────
# Streaming RAG assistant. The model calls a `search` tool against the
# knowledge base rather than receiving pre-retrieved context.

# [REQUIRED] Full chat-completions endpoint URL.
MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions

# [REQUIRED]
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# [REQUIRED]
MOONSHOT_KIMI_MODEL=moonshot-v1-8k

# [OPTIONAL] Defaults to 0.5.
MOONSHOT_KIMI_TEMPERATURE=0.5

# [OPTIONAL] Completions per request. Defaults to 1.
MOONSHOT_KIMI_N=1

# [OPTIONAL] "auto", "none", or a forced tool. Defaults to "auto".
MOONSHOT_KIMI_TOOL_CHOICE=auto


# ── Embeddings & translation (Alibaba DashScope / Qwen) ───────────────────────

# [REQUIRED] Shared by the embedding and translation services.
DASHSCOPE_API_KEY=replace_me_dashscope_api_key

# [REQUIRED] OpenAI-compatible base URL for the embedding client.
QWEN_EMBEDDING_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# [REQUIRED] Embedding model id. Must produce 2048-dimension vectors to match
# the Qdrant collection.
QWEN_EMBEDDING_MODEL_ID=text-embedding-v3

# [REQUIRED] Translation model tier — "turbo" or "plus". Interpolated into the
# model name as qwen-mt-<value>.
QWEN_MT_TYPE=turbo


# ── Dormant: ticket classifier ────────────────────────────────────────────────
# Read only by src/tickets, whose TicketModule is currently commented out of
# AppModule. Nothing below is loaded at runtime today. Kept for when the module
# is re-enabled; all three are read with getOrThrow and will be required then.

# CLASSIFIER_API_URL=https://api-inference.huggingface.co/models/facebook/bart-large-mnli
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# SIMILARITY_SEARCH_THRESHOLD=0.7


# ==============================================================================
# Removed in this revision — these were documented but read by no code:
#
#   ACCESS_JWT_SECRET, REFRESH_JWT_SECRET  → superseded by the four
#                                            USER_*/GUEST_* secrets above
#   THROTTLER_TTL, THROTTLER_LIMIT         → @nestjs/throttler is not installed;
#                                            there is no rate limiting yet
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
#   VAPID_SUBJECT                          → web-push is never configured with
#                                            them, so push delivery is inert
#   CHATBOT_API_URL, CHATBOT_MODEL_ID      → replaced by MOONSHOT_*
#   CLASSIFYING_THRESHOLD                  → replaced by SIMILARITY_SEARCH_THRESHOLD
#   MORGAN_FORMAT                          → morgan is not used (Fastify/pino)
#   CORS_CREDENTIALS                       → credentials is hardcoded to true
#   COOKIE_DOMAIN                          → cookies are set without a domain
#   GUEST_TTL                              → guest lifetime comes from the JWT
#
# If any of these appear in an existing .env, they are safe to delete.
# ==============================================================================
